// GameBoy LCD
// Authentic Nintendo Game Boy LCD screen aesthetic
// STRICT 4-color palette: #9BBC0F (lightest), #8BAC0F (light), #306230 (dark), #0F380F (darkest)
// The constraint IS the identity - no interpolated colors!
// Author: Claude

// Core - Only 4 colors with alpha variants for depth
Gradient: false
Transparent: #00000000
Image Source: #00000000
Inherited: #8BAC0F
White: #9BBC0F
Black: #0F380F
Same as background: #00000000
Accent: #9BBC0F
Default text: #0F380F
