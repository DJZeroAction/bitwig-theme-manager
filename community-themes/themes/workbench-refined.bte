// Workbench
// Authentic Commodore Amiga Workbench 1.x interface
// Strict 4-color palette: Blue #0055AA, White #FFFFFF, Black #000000, Orange #FF8800
// Blue-tinted greys for cohesive feel, orange primary accent, white secondary for automation
// Flat knobs (no emboss) for authentic retro look
// Author: Claude

// Core
Gradient: false
Transparent: #00000000
Image Source: #00000000
